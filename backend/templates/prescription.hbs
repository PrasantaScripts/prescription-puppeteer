<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Medical Prescription</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 20px;
            color: #333;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
            border-bottom: 2px solid #2c3e50;
            padding-bottom: 10px;
        }

        .clinic-info {
            margin-bottom: 20px;
        }

        .main-content {
            padding: 20px 0;
        }

        .section {
            margin-bottom: 25px;
        }

        .section-title {
            color: #2c3e50;
            border-bottom: 1px solid #eee;
            padding-bottom: 5px;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .vitals-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 10px;
            margin-bottom: 15px;
        }

        .vital-item {
            background: #f8f9fa;
            padding: 8px;
            border-radius: 4px;
        }

        .vital-label {
            font-weight: bold;
            color: #2c3e50;
        }

        .symptoms-list, .tests-list, .advice-list {
            padding-left: 20px;
        }

        .medications-table {
            width: 100%;
            border-collapse: collapse;
            margin: 10px 0;
        }

        .medications-table th, .medications-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        .medications-table th {
            background-color: #f8f9fa;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .signature-line {
            margin-top: 30px;
            text-align: right;
        }

        .prescription-id {
            font-size: 12px;
            color: #666;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h2>{{clinic_name}}</h2>
        <p>{{clinic_address}}</p>
    </div>

    <div class="main-content">
        <!-- Patient Information -->
        <div class="section">
            <h3 class="section-title">Patient Information</h3>
            <div class="patient-info">
                <div>
                    <span class="vital-label">Patient Name:</span> {{patient_name}}
                </div>
                <div>
                    <span class="vital-label">Age/Gender:</span> {{patient_age}}{{#if patient_gender}} / {{patient_gender}}{{/if}}
                </div>
                <div>
                    <span class="vital-label">Date:</span> {{date}}
                </div>
            </div>
        </div>

        <!-- Physical Examination -->
        <div class="section">
            <h3 class="section-title">Physical Examination</h3>
            <div class="vitals-grid">
                {{#each physical_examination_of_patient}}
                <div class="vital-item">
                    <span class="vital-label">{{this.key}}:</span> {{this.val}}
                </div>
                {{/each}}
            </div>
        </div>

        <!-- Symptoms -->
        <div class="section">
            <h3 class="section-title">Presenting Symptoms</h3>
            <ul class="symptoms-list">
                {{#each patient_registered_symptoms}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>

        <!-- Past History -->
        {{#if past_history}}
        <div class="section">
            <h3 class="section-title">Past History</h3>
            <ul class="symptoms-list">
                {{#each past_history}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
        {{/if}}

        <!-- Diagnosis -->
        <div class="section">
            <h3 class="section-title">Diagnosis</h3>
            <ul class="symptoms-list">
                {{#each treatment_diagnosis}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>

        <!-- Medications -->
        <div class="section">
            <h3 class="section-title">Prescribed Medications</h3>
            <table class="medications-table">
                <thead>
                    <tr>
                        <th>Medicine</th>
                        <th>Strength</th>
                        <th>Schedule</th>
                        <th>Special Instructions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each medication}}
                    <tr>
                        <td>{{this.medicineName}}</td>
                        <td>{{this.power}}</td>
                        <td>{{this.eating_schedule}}</td>
                        <td>{{this.advice}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>

        <!-- Tests -->
        {{#if tests_to_do}}
        <div class="section">
            <h3 class="section-title">Recommended Tests</h3>
            <ul class="tests-list">
                {{#each tests_to_do}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
        {{/if}}

        <!-- Advice -->
        <div class="section">
            <h3 class="section-title">Medical Advice</h3>
            <ul class="advice-list">
                {{#each advices_by_doctor}}
                <li>{{this}}</li>
                {{/each}}
            </ul>
        </div>
    </div>

    <div class="footer">
        <div class="signature-line">
            <p>Doctor's Signature: _________________</p>
            <p>{{doctor_name}}{{#if doctor_qualifications}}, {{doctor_qualifications}}{{/if}}</p>
        </div>
        <div class="prescription-id">
            Prescription ID: {{appointmentId}}
        </div>
    </div>
</body>
</html>